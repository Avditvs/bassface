/**
 * Cloudflare deployment for the Bassface frontend: static assets only
 * (no worker script). Cloudflare has merged Pages into Workers, so the
 * site deploys as a Worker with static assets — `npx wrangler deploy`.
 * Hash routing (#/playlists) needs no server-side routing; SPA fallback
 * is enabled anyway so unknown paths serve index.html.
 */
{
  "name": "bassface",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
