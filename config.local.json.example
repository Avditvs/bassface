{
  "//": "Local dev config — copy to public/config.local.json (gitignored). Served at the app root and applied on loopback origins only. mode \"credentials\": token requests go straight to SoundCloud with the Client ID/Secret below (default when the file is missing). mode \"proxy\": token requests go through the token proxy (worker/).",
  "mode": "credentials",
  "clientId": "YOUR_CLIENT_ID",
  "clientSecret": "YOUR_CLIENT_SECRET",
  "redirectUri": "http://127.0.0.1:8080/",
  "tokenProxyUrl": "https://soundcloud-token-proxy.louis-germain.fr"
}
