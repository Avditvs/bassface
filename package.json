{
  "name": "bassface",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "Bassface — backend-free SoundCloud playlist manager (OAuth 2.1 + PKCE, React client)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "dev": "vite",
    "watch": "vite",
    "serve": "npm run build && python3 -m http.server 8080 --bind 127.0.0.1 --directory dist"
  },
  "dependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.2",
    "vite": "^8.3.0"
  }
}
